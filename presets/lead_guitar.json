{
  "name": "Lead Guitar",
  "instrument": "guitar_lead",
  "description": "General-purpose plucked-string lead: moderate brightness, light drive, short delay/reverb tail.",
  "params": {
    "damping": 0.4,
    "sustain_decay": 0.985,
    "release_time": 0.35,
    "pick_noise_color": 0.5,
    "drive": 0.18,
    "compressor_threshold_db": -20.0,
    "compressor_ratio": 3.0,
    "chorus_mix": 0.25,
    "delay_enabled": true,
    "delay_seconds": 0.32,
    "delay_feedback": 0.3,
    "delay_mix": 0.2,
    "reverb_enabled": true,
    "reverb_mix": 0.22,
    "reverb_decay": 0.5,
    "master_gain": 0.6,
    "expression": 0.3
  }
}
